


import pandas as pd


transactions = [
    ['Laptop', 'Mouse', 'Laptop Bag'],
    ['Laptop', 'Keyboard', 'Mouse'],
    ['Mobile', 'Charger', 'Earphones'],
    ['Laptop', 'Mouse', 'Keyboard', 'Laptop Bag'],
    ['Mobile', 'Charger', 'Screen Guard'],
    ['Laptop', 'Laptop Bag', 'Mouse'],
    ['Mobile', 'Earphones', 'Screen Guard'],
    ['Laptop', 'Keyboard', 'Mouse', 'Mouse Pad'],
    ['Mobile', 'Charger', 'Earphones', 'Screen Guard'],
    ['Laptop', 'Mouse', 'Mouse Pad']
]

itemsets = [
    {'Laptop'},
    {'Mouse'},
    {'Mobile'},
    {'Laptop', 'Mouse'},
    {'Mobile', 'Charger'},
    {'Laptop', 'Mouse', 'Keyboard'}
]

rules = [
    ({'Laptop'}, {'Mouse'}),
    ({'Mobile'}, {'Charger'}),
    ({'Laptop', 'Mouse'}, {'Keyboard'}),
    ({'Charger'}, {'Mobile'})
]





total_transac=len(transactions)
support_itemsets=[]
for i in itemsets:
    count = sum(i.issubset(tran) for tran in transactions)
    support = count/total_transac
    support_itemsets.append({
        'items':', '.join(sorted(i)),
        'count':count,
        'support':support
    })
support_df= pd.DataFrame(support_itemsets)
print(support_df.to_string())





def support(transaction,X,Y={}):
    if Y!={}:
        return support(transaction,X.union(Y))
    count=sum(X.issubset(j) for j in transaction)
    return count/len(transaction)
def confidence(transaction,X,Y):
    return support(transaction,X,Y)/support(transaction,X)


results = []
for X, Y in rules:
    results.append({
        "Antecedent": ", ".join(X),
        "Consequent": ", ".join(Y),
        "Support": support(transactions, X, Y),
        "Confidence": confidence(transactions, X, Y)
    })
df = pd.DataFrame(results)
print(df.to_string(index=False))
